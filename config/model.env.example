# Copy this file to .env.local. Never commit an actual key.
ELFRED_MODEL_API_KEY=replace-with-your-key
# Optional: defaults work with an OpenAI key.
# ELFRED_MODEL_BASE_URL=https://api.openai.com/v1
# ELFRED_MODEL_NAME=gpt-4.1-mini
# ELFRED_AUDIO_MODEL=gpt-4o-mini-transcribe
# Optional semantic retrieval; an official OpenAI key is reused by default.
# For a relay, set an explicitly supported embedding key and model.
# ELFRED_EMBEDDING_API_KEY=
# ELFRED_EMBEDDING_BASE_URL=https://api.openai.com/v1
# ELFRED_EMBEDDING_MODEL=text-embedding-3-small
# Web search needs the Responses API with web_search; images need the Images API.
# These may reuse an official OpenAI key. Relay chat keys do not imply support.
# ELFRED_EXTERNAL_API_KEY=
# ELFRED_EXTERNAL_BASE_URL=https://api.openai.com/v1
# ELFRED_WEB_MODEL=gpt-4.1-mini
# ELFRED_IMAGE_MODEL=gpt-image-1
# Optional Jev structured judgments. Obtain a key at https://console.typesafe.ai/keys
# This is independent of the text model key; no key is sent to the browser.
# TYPESAFE_API_KEY=
# ELFRED_JEV_MODEL=jev-latest
# Local document extraction tools (already installed on this workstation):
# ELFRED_PYTHON=python
# ELFRED_PDFTOTEXT=pdftotext
